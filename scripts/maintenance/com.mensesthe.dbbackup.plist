<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.mensesthe.dbbackup — DB の丸ごとの控え（scripts/maintenance/backup_db.mjs）を週1回つくる（2026-10-12）

  動き方:
    ・毎日 10:30 と、ログイン・再起動・再登録のときに起きて、**最後の成功から6日たっていたら**書き出す
      （--if-older-than-days=6）。Mac が止まっていた週も、次に起きたときに取りに行く。
    ・書き出したら / 失敗したら Mac に通知が出る。失敗したときは backups/db/last-failure.json にも残る。
    ・新しい8つの控え（約2か月分）を残し、それより古いものは消す。

  ⚠️ launchd に ~/Downloads の中のファイルを直接起動させない（TCC で Operation not permitted になる）。
     /bin/zsh を起動し、その子の node が読み書きする形にする（com.mensesthe.metrics と同じ・2026-08-11 の教訓）。

  登録（手元のターミナル）:
    cp scripts/maintenance/com.mensesthe.dbbackup.plist ~/Library/LaunchAgents/
    launchctl unload ~/Library/LaunchAgents/com.mensesthe.dbbackup.plist 2>/dev/null
    launchctl load   ~/Library/LaunchAgents/com.mensesthe.dbbackup.plist
    launchctl list | grep mensesthe
  ログ: backups/db/backup.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.mensesthe.dbbackup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/okabayashi/Downloads/mens-esthe-site &amp;&amp; node scripts/maintenance/backup_db.mjs --if-older-than-days=6</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>10</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>

  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>300</integer>
  <!-- スリープ明けの通信待ちで最大約4分やり直すので、停止猶予に余裕を持たせる -->
  <key>ExitTimeOut</key>
  <integer>900</integer>

  <key>StandardOutPath</key>
  <string>/Users/okabayashi/Downloads/mens-esthe-site/backups/db/backup.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/okabayashi/Downloads/mens-esthe-site/backups/db/backup.log</string>
</dict>
</plist>
